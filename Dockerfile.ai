ARG SUBSYNQ_BASE_IMAGE=subsynq:local
FROM ${SUBSYNQ_BASE_IMAGE}
USER root
COPY ai/constraints-worker.txt /tmp/constraints-worker.txt
# faster-whisper 1.2.1 passes metadata_errors to av.open(); PyAV 19 removed it.
RUN pip install --no-cache-dir -c /tmp/constraints-worker.txt faster-whisper==1.2.1 av==18.1.0 psutil
COPY app/ /app/
COPY ai/ /ai/
USER subsynq
ENV HF_HOME=/models/huggingface HF_HUB_DISABLE_TELEMETRY=1
ENTRYPOINT ["python", "-u", "/ai/sample.py"]
