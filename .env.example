SUBSYNQ_PORT=8765
SUBSYNQ_UID=1000
SUBSYNQ_GID=1000
SUBSYNQ_TV_PATH=./data/tv
SUBSYNQ_MOVIES_PATH=./data/movies
SUBSYNQ_EXTRA_PATH=./data/extra
# Adress webbgränssnittet lyssnar på. 127.0.0.1 = bara den här datorn (säkrast).
# Sätt 0.0.0.0 för att nå det från andra enheter i hemmanätverket. Det finns ingen inloggning,
# så använd det bara på ett nätverk du litar på och exponera aldrig porten mot internet.
SUBSYNQ_BIND_IP=127.0.0.1
