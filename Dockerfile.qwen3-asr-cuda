FROM python:3.12-slim-bookworm
COPY ai/constraints-qwen.txt /tmp/constraints-qwen.txt
RUN grep -qx 'torch==2.9.1+cpu' /tmp/constraints-qwen.txt \
    && sed 's/^torch==2.9.1+cpu$/torch==2.9.1+cu128/' \
        /tmp/constraints-qwen.txt > /tmp/constraints-cuda.txt \
    && apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 sox \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir torch==2.9.1+cu128 \
        --index-url https://download.pytorch.org/whl/cu128 \
    && pip install --no-cache-dir -c /tmp/constraints-cuda.txt qwen-asr==0.0.6 \
    && pip check
COPY ai/qwen3_asr_compare.py /ai/qwen3_asr_compare.py
COPY ai/qwen_asr_service.py /ai/qwen_asr_service.py
ENV HF_HOME=/models/huggingface HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false NUMBA_CACHE_DIR=/tmp/numba
ENTRYPOINT ["python", "-u", "/ai/qwen_asr_service.py"]
